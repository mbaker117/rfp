# Copy to .env and fill in values

# Which provider serves the LLM calls: anthropic | openai | deepseek.
# Switching provider is this one line — each provider keeps its own key below, so they can all stay set.
RFP_LLM_PROVIDER=anthropic
# Leave blank to use the provider's default model (claude-sonnet-4-6 / gpt-5-mini / deepseek-flash).
RFP_LLM_MODEL=
# Leave blank to use the provider's own endpoint.
RFP_LLM_BASE_URL=

RFP_LLM_ANTHROPIC_API_KEY=
RFP_LLM_OPENAI_API_KEY=
RFP_LLM_DEEPSEEK_API_KEY=
# Used by whichever provider has no key of its own.
RFP_LLM_API_KEY=

JWT_SECRET=
